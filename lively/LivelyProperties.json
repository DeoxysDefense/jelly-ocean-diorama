  "surpriseFrequency": {
    "type": "dropdown",
    "value": 1,
    "text": "How often",
    "items": [
      "Rare",
      "Normal",
      "Often"
    ]
  },
  "visitors": {
    "type": "dropdown",
    "value": 2,
    "text": "Rare visitors (turtles, mantas, dolphins …) / 稀有访客",
