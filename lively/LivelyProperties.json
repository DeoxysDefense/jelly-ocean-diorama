    "type": "checkbox",
    "value": true,
    "text": "Tide cycle (sea level rises and falls)"
  },
  "waterColor": {
    "type": "dropdown",
    "value": 0,
    "text": "Water color",
    "items": [
      "Tropical Turquoise",
      "Lagoon Blue",
      "Deep Ocean Blue",
      "Sea Glass Green",
      "Warm Sunset",
      "Custom"
    ]
  },
  "customColor": {
    "type": "color",
    "value": "#22B8C8",
    "text": "Custom water color (select 'Custom' above)"
  },
  "language": {
    "type": "dropdown",
    "value": 0,
    "text": "Language for notes & mini games / 语言",
    "items": [
      "Auto (system)",
      "中文",
      "English"
    ]
  },
  "oceanMail": {
    "type": "checkbox",
    "value": true,
    "text": "Ocean Mail (a rare drifting bottle with a note)"
