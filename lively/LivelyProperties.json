{
  "playMode": {
    "type": "checkbox",
    "value": false,
    "text": "Interactive Play mode (shows controls; needs Lively mouse input)"
  },
  "defaultView": {
    "type": "dropdown",
    "value": 0,
    "text": "Camera view / 镜头",
    "items": [
      "Focus (close-up, v1 framing) / 近景",
      "Full (the whole archipelago) / 全景",
      "Top (map, for editing) / 俯视"
    ]
  },
  "autoDrift": {
    "type": "checkbox",
    "value": false,
    "text": "Slow camera drift along the islands / 镜头慢慢漂移"
  },
  "windStrength": {
    "type": "slider",
    "value": 25,
    "min": 0,
    "max": 100,
    "step": 1,
    "tick": 10,
    "text": "Wind strength"
  },
  "timeMode": {
    "type": "dropdown",
    "value": 2,
    "text": "Time of day",
    "items": [
      "Fixed afternoon",
      "Accelerated day cycle",
      "Follow PC clock"
    ]
  },
  "rain": {
    "type": "slider",
    "value": 0,
    "min": 0,
    "max": 100,
    "step": 1,
    "tick": 10,
    "text": "Rain"
